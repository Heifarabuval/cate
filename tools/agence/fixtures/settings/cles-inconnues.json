      {"matcher": "Inconnu", "hooks": [{"type": "prompt", "prompt": "texte libre"}]}
    ],
    "PreToolUse": [
      {"matcher": "Write", "hooks": [{"type": "command", "command": "/opt/outils/garde.sh", "champFutur": 1}]}
    ]
  }
}
