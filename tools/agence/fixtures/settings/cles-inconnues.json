{
  "model": "exemple",
  "cleInventeeParUneVersionFuture": {"a": [1, 2, {"b": null}], "ordre": ["z", "a", "m"]},
  "nombreGrand": 12345678901234567890,
  "decimal": 1.0,
  "texte": "accents é à ü, emoji 🙂, barre \\ et guillemet \"",
